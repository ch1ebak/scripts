#!/usr/bin/env bash

set -e
set -u

Projects () {
  Scripts () {
  	emacs ~/Projekty/
  }
  NixOS_BTW () {
  	emacs ~/.nixos-btw/configuration.nix
  }
  Dotfiles () {
  	emacs ~/.dotfiles/.config/
  }
  Writing () {
  	emacs --eval '(wg-open-workgroup nil)'
  }
  Notes () {
  	emacs ~/Dokumenty/notatki
  }
  
  declare -a options=(
  	Dotfiles
  	NixOS_BTW
		Scripts
  	Notes	
  	Writing	
  	"Quit")
  
  choice=$(printf '%s\n' "${options[@]}" | rofi -m 1 -dmenu -i -l 20 -p 'Projects')
  
  if [[ "$choice" == quit ]]; then
  	echo "Program Terminated." && exit 1
  elif [ "$choice" ]; then
  	cfg=$(printf '%s\n' "${choice}" | awk '{print $NF}')
  	"$cfg"
  else
  	echo "Program Terminated." && exit 1
  fi
}

Restart () {
  Restart_SwayBG () {
		if [ $XDG_SESSION_TYPE = 'wayland' ]; then
			nohup bash -c "pkill swaybg; swaybg -i $(shuf -e -n1 $HOME/Obrazy/wallpapers/*) & disown"
			dunstify "SwayBG restarted."
		else
			echo "What?"
		fi
  }
  Restart_Waybar () {
  	if [ $XDG_SESSION_TYPE = 'wayland' ]; then
  		nohup bash -c "killall .waybar-wrapped && waybar & disown"
			dunstify "Waybar restarted."
  	else
  		echo "What?"
  	fi
  }
  Restart_Mango () {
  	if [ $XDG_CURRENT_DESKTOP = 'mango' ]; then
  		nohup bash -c "mmsg -d reload_config"
			dunstify "Mango restarted."
  	else
  		echo "What?"
  	fi
  }

  declare -a options=(
	Restart_SwayBG
	Restart_Waybar
	Restart_Mango
  "quit")

  choice=$(printf '%s\n' "${options[@]}" | rofi -m 1 -dmenu -i -l 20 -p 'Utilities')
  if [[ "$choice" == quit ]]; then
    echo "Program Terminated." && exit 1
  elif [ "$choice" ]; then
    cfg=$(printf '%s\n' "${choice}" | awk '{print $NF}')
    "$cfg"
  else
    echo "What?" && exit 1
  fi
}

Screenshot () {
if [ $XDG_SESSION_TYPE = 'wayland' ]; then
  sleep 1; grim -o HDMI-A-1 -l 9 -t png
  notify-send "Screenshot Taken"
elif [ $XDG_SESSION_TYPE = 'x11' ]; then
  scrot -d 1 -M 0 -q 9
  notify-send "Screenshot Taken"
else
  echo "What?"
fi
}

Wallpaper () {
if [ $XDG_SESSION_TYPE = 'wayland' ]; then
	swaybg -i $(shuf -e -n1 $HOME/Obrazy/wallpapers/*) & disown
elif [ $XDG_SESSION_TYPE = 'x11' ]; then
  shuf -e -n1 $HOME/Obrazy/wallpapers/* | xargs feh --bg-fill
else
  echo "What?"
fi
}

Themes () {
  catppuccin () {
    # rofi
    sed -i 's@themes/*.*@themes/catppuccin"@g' /home/$USER/.dotfiles/.config/rofi/config.rasi
    # terminal
    if [ -d /home/$USER/.dotfiles/.config/ghostty ]; then
      sed -i 's@themes/*.*@themes/Catppuccin Mocha@g' /home/$USER/.dotfiles/.config/ghostty/config
    elif [ -d /home/$USER/.dotfiles/.config/wezterm ]; then
      sed -i "s/color_scheme\ =\ '*.*/color_scheme\ =\ 'Catppuccin Mocha',/g" /home/$USER/.dotfiles/.config/wezterm/wezterm.lua 
    else
      echo "Terminal not updated"
    fi
		# editors
		if [ -d /home/$USER/.dotfiles/.config/nvim ]; then
      sed -i "s@colorscheme\ *.*@colorscheme catppuccin'@g" /home/$USER/.dotfiles/.config/nvim/lua/core/colorscheme.lua
      sed -i "s@theme\ =\ *.*@theme\ =\ 'catppuccin-nvim',@g" /home/$USER/.dotfiles/.config/nvim/lua/plugins/lualine.lua
		elif [ -d /home/$USER/.dotfiles/.config/emacs ]; then
      sed -i "s/load-theme\ '*.*/load-theme 'catppuccin\ :no-confirm)/g" /home/$USER/.dotfiles/.config/emacs/init.el
		else
			echo "Editor not updated"
		fi
    # WMs
    if [ $XDG_CURRENT_DESKTOP = 'Hyprland' ]; then
			sed -i 's@themes/*.*@themes/catppuccin")@g' /home/$USER/.dotfiles/.config/hypr/hyprland.lua
			sed -i 's@wallpapers/*.*@wallpapers/catppuccin.png@g' /home/$USER/.dotfiles/.config/hypr/hyprlock.conf
			sed -i 's@themes/*.*@themes/catppuccin.css";@g' /home/$USER/.dotfiles/.config/waybar/style.css
      nohup bash -c "pkill swaybg; swaybg -i ~/.dotfiles/wallpapers/catppuccin.png &"
      nohup bash -c "killall .waybar-wrapped && waybar & disown"
    elif [ $XDG_CURRENT_DESKTOP = 'qtile' ]; then
			sed -i 's/themes.*\ import\ colors/themes.catppuccin\ import\ colors/g' /home/$USER/.dotfiles/.config/qtile/config.py
			sed -i 's@wallpapers/*.*@wallpapers/catppuccin.png",@g' /home/$USER/.dotfiles/.config/qtile/config.py
      qtile cmd-obj -o cmd -f reload_config
		elif  [ $XDG_CURRENT_DESKTOP = 'mango' ]; then
			sed -i 's@themes/*.*@themes/catppuccin.conf@g' /home/$USER/.dotfiles/.config/mango/config.conf
			sed -i 's@themes/*.*@themes/catppuccin.css";@g' /home/$USER/.dotfiles/.config/waybar/style.css
			sed -i 's@wallpapers/*.*@wallpapers/catppuccin.png@g' /home/$USER/.dotfiles/.config/hypr/hyprlock.conf
      nohup bash -c "pkill swaybg; swaybg -i ~/.dotfiles/wallpapers/catppuccin.png &"
      nohup bash -c "mmsg -d reload_config"
    else
      echo "What?"
    fi
    # dunst
    sed -i 's@background\ =\ "#*.*@background\ =\ "#1e1e2e"@g' /home/$USER/.dotfiles/.config/dunst/dunstrc
    sed -i 's@foreground\ =\ "#*.*@foreground\ =\ "#cdd6f4"@g' /home/$USER/.dotfiles/.config/dunst/dunstrc
    sed -i 's@frame_color\ =\ "#*.*@frame_color\ =\ "#cba6f7"@g' /home/$USER/.dotfiles/.config/dunst/dunstrc
    killall -e .dunst-wrapped & sleep 1; dunstify "Theme switched to Catppuccin" &
