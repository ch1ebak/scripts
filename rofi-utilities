    sed -i 's@frame_color\ =\ "#*.*@frame_color\ =\ "#7aa2f7"@g' /home/$USER/.dotfiles/.config/dunst/dunstrc
    killall -e .dunst-wrapped & sleep 1; dunstify "Theme switched to Tokyo Night" &
